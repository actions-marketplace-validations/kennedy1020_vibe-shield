{
  "name": "@kennedy1020/vibe-shield",
  "version": "1.1.5",
  "description": "Zero-config security auditor and slopsquatting detector for Next.js, Supabase, Prisma, Stripe, Paystack, and PayPal stacks",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "vibe-shield": "dist/cli.js",
    "@kennedy1020/vibe-shield": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kennedy1020/vibe-shield.git"
  },
  "bugs": {
    "url": "https://github.com/kennedy1020/vibe-shield/issues"
  },
  "homepage": "https://github.com/kennedy1020/vibe-shield#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "rules",
    "README.md",
    "action.yml"
  ],
  "scripts": {
    "build": "tsc && ncc build dist/action.js -o dist -m",
    "test": "node test/run-test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "security",
    "slopsquatting",
    "hallucinated-packages",
    "nextjs",
    "ast",
    "semgrep",
    "sarif",
    "supabase",
    "stripe",
    "paystack",
    "paypal",
    "prisma",
    "idor"
  ],
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@vercel/ncc": "^0.38.1",
    "typescript": "^5.5.4"
  }
}
