{
  "name": "vibe-shield",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "vibe-shield": "./dist/cli.js"
  },
  "scripts": {
    "build:cli": "tsc",
    "build:action": "ncc build dist/action.js -o dist --minify --license licenses.txt",
